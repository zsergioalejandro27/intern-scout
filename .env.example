# Copia este archivo como .env y reemplaza los valores con tus propias credenciales.
# .env NUNCA se sube a git (ya está en .gitignore).

# Connection string de tu cluster MongoDB Atlas (Database > Connect > Drivers > Python)
MONGO_URI=mongodb+srv://<usuario>:<password>@cluster0.xxxxx.mongodb.net/?appName=Cluster0

# Token que te dio @BotFather al crear el bot con /newbot
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRstuVwxyZ

# El "id" dentro de "chat" que obtuviste en https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=123456789
